# HTTP API
PORT=3000

# Redis (BullMQ queues + tracker state)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Polling
POLL_CRON=*/5 * * * *
TRACKERS_FILE=config/trackers.json
HTTP_TIMEOUT_MS=15000
# HTTP_USER_AGENT=

# Alerts
PRICE_DROP_THRESHOLD_PERCENT=1

# Notification channels (each one is enabled when its variables are set)
ALERT_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
